# Trusted by the queue, not the prompt: one team member is a mandate + skills +
# hooks + settings, all in version control, none in the model. Swap the model
# and the team is still the team.
# NEW for the flagship (2026-09-02, take three): replaces the formula paragraph.
direction: right
horizontal-gap: 130
vertical-gap: 45

mandate: "MANDATE\nThe One Job It Owns" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}
skills: "SKILLS\nThe Playbooks: Test-First,\nReview-Your-Diff, the Report Format" {
  style: {fill: "#fff7ed"; stroke: "#d97706"; font-color: "#7c2d12"; bold: true}
}
hooks: "HOOKS\nRules Enforced on\nEvery Tool Call" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}
settings: "SETTINGS\nStamped From\nHuman-Committed Harness Code" {
  style: {fill: "#ffffff"; stroke: "#94a3b8"; font-color: "#475569"; bold: true}
}

member: "ONE TEAM MEMBER\nA Single-Purpose Durable Job.\nTrusted by the QUEUE It Polls,\nNot the PROMPT It Was Handed." {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}

swap: "All Four Ride in Version Control ·\nNone Lives in the Model.\nSwap the Model Tomorrow,\nthe Team Is Still the Team." {
  style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
}

mandate -> member
skills -> member
hooks -> member
settings -> member
member -> swap: "Because"
