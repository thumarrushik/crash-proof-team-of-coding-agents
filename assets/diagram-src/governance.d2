# Governance: two planes of evidence, joined on the session id.
# Two wide records on top, one join key below.
direction: down
vertical-gap: 85

temporal: "Temporal: What the JOB Did\nEvery Attempt · Every Failure · Every Cost · …" {
  width: 660
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}
workspace: "The Workspace: What the AGENT Did\nEvery Tool Call · the Full Transcript · the Pass/Fail Report" {
  width: 660
  style: {fill: "#fff7ed"; stroke: "#d97706"; font-color: "#7c2d12"; bold: true}
}
key: "The Session ID\nOne Join Key Ties the Two Together" {
  width: 520
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}

key -> temporal: "Opens the Job's Ledger"
key -> workspace: "Opens the Agent's File"
