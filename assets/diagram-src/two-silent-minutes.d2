# The resurrection on a clock, plus the two things the kill could not reach.
# Comic-strip grid (column-major fill): top row the clock, bottom-right the survivors.
grid-columns: 5
horizontal-gap: 70
vertical-gap: 110

a1: "Attempt 1\nA Pulse Every 30s, Each\nCarrying the Session ID" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}
sp1: "" {style: {opacity: 0}}
kill: "T+0:00\nSIGKILL,\nWhole Tree" {
  style: {fill: "#fee2e2"; stroke: "#dc2626"; font-color: "#7f1d1d"; bold: true}
}
sp2: "" {style: {opacity: 0}}
silence: "T+0:00 to T+2:00\nSilence\n(Nothing Pulses)" {
  style: {fill: "#f8fafc"; stroke: "#94a3b8"; font-color: "#475569"; bold: true}
}
sp3: "" {style: {opacity: 0}}
dead: "T+2:00\nThe Server Declares\nthe Attempt Dead" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}
pulse: "Survivor on the Server:\nthe Last Pulse,\nCarrying the Session ID" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}
a2: "T+2:01\nAttempt 2, Restarted,\nResumes the SAME Session" {
  style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
}
transcript: "Survivor on Disk:\nthe Transcript, Filed\nUnder That Same ID" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}

a1 -> kill -> silence -> dead -> a2
pulse -> transcript: {
  style: {stroke-dash: 5; stroke: "#7c3aed"; bold: true}
}
transcript -> a2: "Read, Reopened" {
  style: {stroke: "#16a34a"; font-color: "#14532d"; bold: true}
}
