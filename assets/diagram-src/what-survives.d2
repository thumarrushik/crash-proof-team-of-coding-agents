# What survives a kill: the two records the crash cannot reach, joined by the session ID.
grid-rows: 2
horizontal-gap: 300
vertical-gap: 110

mem: "Dies With the Worker\nThe Session Variable · The Retry Count ·\nThe Fact a Job Was Running at All\n(All of It Process Memory)" {
  style: {fill: "#fee2e2"; stroke: "#dc2626"; font-color: "#7f1d1d"; bold: true}
}
pulse: "Survives on the Server\nThe Last Heartbeat, Sent Seconds\nBefore the Kill, Carrying the Session ID" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}
transcript: "Survives on Disk\nThe Transcript: the Whole Conversation,\nFiled Under That Same Session ID" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}
resume: "Attempt 2 Needs Nothing Else\nRead the ID From the Pulse,\nReopen the Transcript, Resume" {
  style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
}

pulse -> resume: "The Key"
transcript -> resume: "The Memory"
