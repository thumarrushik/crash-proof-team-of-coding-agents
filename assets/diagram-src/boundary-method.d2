# How to price a boundary honestly: hold the work at zero with a one-turn
# no-op resume, so whatever the no-op costs IS the boundary.
direction: right
horizontal-gap: 130

build: "1 · Build One Session to a Fixed Prefix\n(~30k Tokens of Real Conversation),\nThen Resume It With a ONE-TURN NO-OP:\n\"Reply OK, No Tools\" — Zero New Work,\nSo the No-Op's Bill Is PURE Boundary" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}

warm: "2a · The WARM Boundary (Back-to-Back)\n\$0.0035 — a Cache READ\n~3% of the Base Run" {
  style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
}

cold: "2b · The COLD Boundary (65 Idle Minutes)\n\$0.021 — a PARTIAL Cache Write,\nThen It Re-Warms" {
  style: {fill: "#fef9c3"; stroke: "#ca8a04"; font-color: "#713f12"; bold: true}
}

law: "The Boundary Is Linear in the Prefix\nWarm ≈ 0.1× the Input Rate · Cold ≈ 1.25×\nStay Inside the Cache Lifetime\nand Every Seam Is Nearly Free" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}

build -> warm: "back-to-back" {style: {stroke: "#16a34a"; font-color: "#14532d"; bold: true}}
build -> cold: "long stall" {style: {stroke-dash: 3; stroke: "#ca8a04"; font-color: "#713f12"; bold: true}}
warm -> law
cold -> law
