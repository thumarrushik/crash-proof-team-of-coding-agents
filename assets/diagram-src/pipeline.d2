# The whole pipeline: one GitHub issue, durably driven to a merged PR.
# Laid out clockwise: 1,2,3 across the top; 7,6,5,4 across the bottom. The wrap
# edge (3->4) hugs the right and the loop-back (7->2) hugs the left, so they
# never cross. grid-rows:2 splits row-major (3 top, 4 bottom).
grid-rows: 2
horizontal-gap: 150
vertical-gap: 150

issue: "1 · A GitHub Issue Is Filed\nIts Label Routes It to a Team\n'Blocked by: #n' Holds It" {
  style: {fill: "#f1f5f9"; stroke: "#334155"; font-color: "#0f172a"; bold: true}
}
intake: "2 · Durable Intake\nA Scheduled Poll Starts One\nDurable Job per Ready Item" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}
build: "3 · The Issue Lane\nAgent Works in Resumable Chunks\n→ Opens a Pull Request" {
  style: {fill: "#fff7ed"; stroke: "#d97706"; font-color: "#7c2d12"; bold: true}
}

unblock: "7 · The Next Poll\nA Closed Issue Releases the\nDependents It Was Blocking → They Ship" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}
merged: "6 · PR Merged\nIssue Closed" {
  style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
}
merge: "5 · Merge the PR\nStale Branch → Update & Retry\nReal Conflict → the Owning Team\nResolves and Re-Merges" {
  style: {fill: "#fef9c3"; stroke: "#ca8a04"; font-color: "#713f12"; bold: true}
}
review: "4 · The Review Lane\nReads the Diff → Approves\nOnly If the Tests Pass" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}

issue -> intake: "Durable,\nRetried"
intake -> build: "Start in Its\nNamespace"
build -> review: "Handed Over on\nthe NEXT Poll"
review -> merge: "Approve" {style: {stroke: "#4f46e5"; font-color: "#312e81"}}
merge -> merged
merged -> unblock
unblock -> intake: "The Loop Closes on the Next Poll" {style: {stroke-dash: 3; stroke: "#0891b2"; font-color: "#164e63"}}
