# Crash recovery for the price of a heartbeat. Comic-strip: top row, bottom row.
grid-rows: 2
horizontal-gap: 320
vertical-gap: 95

a1: "1 · Attempt 1 Runs the Agent\nNothing Finished, Nothing Saved —\nExcept a Heartbeat Every 30s\nCarrying the Live Session ID" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}
kill: "2 · SIGKILL\nThe Whole Process Tree Dies\nMemory: Gone" {
  style: {fill: "#fee2e2"; stroke: "#dc2626"; font-color: "#7f1d1d"; bold: true}
}
timeout: "3 · The Pulses Stop\nTwo Silent Minutes Later,\nTemporal Declares It Dead and Retries" {
  style: {fill: "#f5f3ff"; stroke: "#7c3aed"; font-color: "#4c1d95"; bold: true}
}
a2: "4 · Attempt 2, Any Worker\nReads the Session ID Out of the\nDead Attempt's LAST Heartbeat" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}
done: "5 · The Same Conversation Finishes\n1 Chunk · \$0.04 Total\nA Resume, Not a Re-Run" {
  style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
}

a1 -> kill -> timeout
timeout -> a2: "Retry, 2 min After the Kill"
a2 -> done
