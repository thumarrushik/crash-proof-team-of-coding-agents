# The human gate: the workflow blocks on a validated decision with a deadline.
# Query = the inbox; update + validator = the decision (rejected before history
# if unsolicited or unattributed); timer = the deny-safe deadline.
direction: right
horizontal-gap: 110

wf: "The Durable Task, Blocked on Purpose\nAction: Merge PR #4 · Gate Open" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
  wait: "wait_condition(decision): a Wait That\nSurvives Crashes, Deploys, and Weeks of\nSilence, at Zero Cost" {
    style: {fill: "#ffffff"; stroke: "#4f46e5"}
  }
}

human: "The Operator CLI" {
  style: {fill: "#ecfdf5"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
  inbox: "Query: the Inbox\nWhat Is Waiting on Me,\nand Its Deadline" {
    style: {fill: "#ffffff"; stroke: "#16a34a"}
  }
  decide: "Update: the Decision\napprove | reject · --by <who>\nValidated BEFORE It Enters History" {
    style: {fill: "#ffffff"; stroke: "#16a34a"}
  }
}

deadline: "The Deadline Timer\n24h of Silence =\nDENY, Recorded as\nDecided-By: 'deadline'" {
  style: {fill: "#fef2f2"; stroke: "#dc2626"; font-color: "#7f1d1d"; bold: true}
}

outcome: "Approved: Merge Runs\nRejected or Expired:\nNo Irreversible Act" {
  style: {fill: "#f8fafc"; stroke: "#64748b"; font-color: "#334155"; bold: true}
}

human.inbox -> wf: "Read-Only" {style: {stroke-dash: 3; stroke: "#16a34a"}}
human.decide -> wf: "Rejected If Unsolicited\nor Unattributed" {style: {stroke: "#16a34a"; bold: true}}
deadline -> wf: "Fires If Nobody Answers" {style: {stroke: "#dc2626"; bold: true}}
wf -> outcome: "One Attributable\nDecision, Always" {style: {stroke: "#4f46e5"; bold: true}}
