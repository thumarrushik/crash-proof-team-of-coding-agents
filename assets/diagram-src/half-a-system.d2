# Act I: the machine two-thirds built. Deliberately NO answer drawn: no
# engine, no supplier. The third socket is empty, and stays empty until
# the closing image fills it (the-whole-at-last.d2).
direction: down

sys: "A Durable Agent System = Three Parts" {
  grid-columns: 3
  horizontal-gap: 60
  style: {fill: "#f8fafc"; stroke: "#94a3b8"; font-color: "#334155"; bold: true}
  conv: "The Conversation: SHIPS\nA Transcript on Disk,\nResumable by ID" {
    style: {fill: "#fff7ed"; stroke: "#d97706"; font-color: "#7c2d12"; bold: true}
  }
  guard: "The Guardrails: SHIP\nDeny Rules · Hooks ·\nOS Sandbox" {
    style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
  }
  hole: "The Job: EMPTY\nThe Part That Would Notice\na Dead Machine and\nMove the Work" {
    style: {fill: "#ffffff"; stroke: "#94a3b8"; font-color: "#64748b"; bold: true; stroke-dash: 5}
  }
}
