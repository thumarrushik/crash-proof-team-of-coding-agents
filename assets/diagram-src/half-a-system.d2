# Claude Code is already half a durable system; the job is the missing half.
# Landscape: three "already has / lacks" cards, then Temporal completes it.
direction: right
horizontal-gap: 260

cc: "What Claude Code Already Is" {
  grid-columns: 3
  horizontal-gap: 180
  style: {fill: "#f8fafc"; stroke: "#334155"; font-color: "#0f172a"; bold: true}
  convo: "The Conversation\nAlready Durable\nA Transcript on Disk,\nResumable by ID" {
    style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
  }
  guard: "The Guardrails\nAlready Enforced\nDeny Rules · Audit Hooks\nOS Sandbox" {
    style: {fill: "#dcfce7"; stroke: "#16a34a"; font-color: "#14532d"; bold: true}
  }
  job: "The Job\nStill Forgotten\nMachine-Local; Nothing Moves\nIt When the Box Dies" {
    style: {fill: "#fee2e2"; stroke: "#dc2626"; font-color: "#7f1d1d"; bold: true}
  }
}

temporal: "Temporal\nRemembers the Job\n(the Other Half)" {
  style: {fill: "#eef2ff"; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}

temporal -> cc.job: "Completes\nthe Missing Half" {
  style: {stroke-dash: 3; stroke: "#4f46e5"; font-color: "#312e81"; bold: true}
}
